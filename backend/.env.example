# ── Database ───────────────────────────────────────
DB_PASSWORD=your_db_password
DB_NAME=task_management
# 告訴 Docker，我本機要用 3307
LOCAL_DB_PORT=3307
# 告訴 Prisma/NestJS，要去連本機的 3307
DATABASE_URL="mysql://root:your_db_password@localhost:3307/task_management"

# ── JWT ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=different_secret_from_jwt_secret_32chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
AI_DAILY_LIMIT=5

# ── App ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
